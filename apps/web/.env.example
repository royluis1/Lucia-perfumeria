# Copiá este archivo a .env.local para desarrollo local.
# En Vercel definilas como Environment Variables (production) del proyecto.

# URL pública del backend (Render). Sin esta var en producción, el build falla a propósito.
NEXT_PUBLIC_API_URL=http://localhost:3005

# URL pública del front (metadata/canonical/sitemap/robots).
NEXT_PUBLIC_SITE_URL=https://lucia-perfumeria.vercel.app