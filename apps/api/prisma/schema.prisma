// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(CUSTOMER)
  name            String
  phone           String?
  mfaEnabled      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]       @relation("AuditLogActor")
}

model RefreshSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

model Product {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  brand       String
  description String
  price       Decimal
  stock       Int
  sku         String      @unique
  isActive    Boolean     @default(true)
  weightGrams Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id                String             @id @default(uuid())
  userId            String
  subtotal          Decimal
  shippingCost      Decimal
  total             Decimal
  status            OrderStatus        @default(PENDING)
  paymentStatus     PaymentStatus      @default(PENDING)
  trackingCode      String?
  shippingAddress   Json
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  paymentPreference PaymentPreference?
  paymentEvents     PaymentEvent[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROCESS
  REFUNDED
  CHARGED_BACK
}

model PaymentPreference {
  id        String         @id @default(uuid())
  orderId   String         @unique
  total     Decimal
  status    PaymentStatus  @default(PENDING)
  sandbox   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events    PaymentEvent[]
}

model PaymentEvent {
  id             String            @id @default(uuid())
  idempotencyKey String            @unique
  eventType      String
  preferenceId   String
  orderId        String
  status         PaymentStatus
  createdAt      DateTime          @default(now())
  preference     PaymentPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([preferenceId, createdAt])
  @@index([orderId, createdAt])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
  @@index([userId, productId, isApproved])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  Json
  createdAt DateTime @default(now())
  actor     User     @relation("AuditLogActor", fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
}
