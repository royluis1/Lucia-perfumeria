# Copia este archivo a .env y completá los valores.
# NUNCA commits `.env` ni `.env.*` con valores reales.

DATABASE_URL="postgresql://admin:TU_CONTRASEÑA@localhost:5432/lucia_perfumeria?schema=public"
PORT=3005
HOST=127.0.0.1
API_CORS_ORIGIN=http://localhost:3000

# Generá con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REEMPLAZAR_POR_SECRETO_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=7d

# Secreto compartido para el webhook local de pagos.
# Generá con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
PAYMENTS_WEBHOOK_SECRET=REEMPLAZAR_POR_SECRETO_WEBHOOK

# Google OAuth (credenciales de tipo "Web application" en Google Cloud Console)
# Autorizá exactamente GOOGLE_REDIRECT_URI como URI de redireccionamiento.
GOOGLE_CLIENT_ID=REEMPLAZAR_CON_CLIENT_ID
GOOGLE_CLIENT_SECRET=REEMPLAZAR_CON_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback
GOOGLE_OAUTH_CLIENT_REDIRECT=http://localhost:3000/auth/oauth

# Uploads de imágenes de producto (carpeta pública y prefijo URL)
UPLOADS_DIR=public
UPLOADS_PREFIX=/uploads

# URL pública de la web (usada en emails y links de reset/confirmación)
WEB_APP_URL=http://localhost:3000

# Email transaccional (SMTP). Para Gmail usá un "Contraseña de aplicación" (App Password),
# NO la contraseña normal de la cuenta:
#   1) Activá 2FA en tu cuenta Google.
#   2) https://myaccount.google.com/apppasswords -> genera una clave de 16 caracteres.
#   3) MAIL_USER = tu email de Gmail, MAIL_PASS = esa clave.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587            # 587=STARTTLS (Gmail), 465=TLS directo
# MAIL_USER=tu@gmail.com
# MAIL_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM="Lucía Perfumería <tu@gmail.com>"
# (Opcional) MAIL_SECURE=0   # fuerzo TSL directo (1) o STARTTLS (0)
# (Opcional) MAIL_IGNORE_TLS=0